# Backend folder store (FastAPI, M2).
#   direct:         http://localhost:3001
#   reverse proxy:  /api    (same-origin with the shell — see README)
VITE_API_BASE=http://localhost:3001

# Editor framed in the iframe (required).
#   direct:         http://localhost:5180/app?embedded=1
#   reverse proxy:  https://gpxstudio.example.com/app?embedded=1
# Note: this also sets the bridge's EDITOR_ORIGIN (outbound postMessage target +
# inbound origin check), so it must be the editor's real origin.
VITE_EDITOR_URL=http://localhost:5180/app?embedded=1

# Poll interval for collaboration (ms)
VITE_POLL_MS=2000
