# Backend config. Copy to `.env` (gitignored) and load with:
#   uvicorn main:app --env-file .env --port 3001
# (requires python-dotenv, in requirements.txt). All values are read via
# os.environ in main.py, so they also work as plain shell env vars.

# Directory of nested .gpx files this serves (the host's folder store).
# Created on startup if missing. Keep it outside the repo / on scratch.
GPX_DATA_DIR=./gpx-data

# Public path prefix when behind a proxy that strips it (the bridge's Vite
# /api proxy does). Makes the auto-docs reference <ROOT_PATH>/openapi.json —
# Swagger at <ROOT_PATH>/docs, ReDoc at <ROOT_PATH>/redoc. Leave unset/empty
# for direct access (docs at /docs).
ROOT_PATH=/api
